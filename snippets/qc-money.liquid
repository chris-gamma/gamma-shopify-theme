{%- doc -%}
  This snippet is used to render a localized price.

  @param {number} price - The price to render
  @param {boolean} [with_currency] - Render the price with the currency code
{%- enddoc -%}

{%- liquid
  assign with_currency = with_currency | default: false
  if request.locale.iso_code == 'fr'
    if with_currency
      assign price = price | money_with_currency
    else
      assign price = price | money
    endif
  else
    # Format the currency for English readers if locale is not 'fr' (we only have 2)
    if with_currency
      assign cur_code = ' CAD'
    else
      assign cur_code = ''
    endif
    assign price = price | money
    assign price = price | replace: ' $', ''
    assign price = price | replace: ',', '.' | replace: ' ', ','
    assign price = '$' | append: price | append: cur_code
  endif
-%}
{{ price }}
