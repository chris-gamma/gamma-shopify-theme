{%- doc -%}
  This snippet is used to render a localized price.

  @param {number} price - The price to render
  @param {boolean} [with_currency] - Render the price with the currency code
{%- enddoc -%}

{%- liquid
  if request.locale.iso_code == 'fr'
    if with_currency
      echo price | money_with_currency
    else
      echo price | money
    endif
  else
    # Format the currency for English readers if locale is not 'fr' (we only have 2)
    echo '$'
    echo price | money_without_currency | replace: ',', '.' | replace: ' ', ','
    if with_currency
      echo ' CAD'
    endif
  endif
-%}