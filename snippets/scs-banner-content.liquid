{% doc %}
  Resolves and renders the product campaign banner.

  @param {product} product - The current product
  @param {boolean} show_image - Whether the banner image should render
  @param {number} image_height - Banner image height in pixels
  @param {boolean} compact_spacing - Whether to use the compact spacing variant

  @example
  {% render 'scs-banner-content', product: product, show_image: true, image_height: 88, compact_spacing: false %}
{% enddoc %}
{% liquid
  assign product_collection_tokens = '|'
  assign winning_campaign = blank
  assign winning_campaign_end_ts = 9999999999
  assign matched_offer = blank

  for product_collection in product.collections
    assign product_collection_tokens = product_collection_tokens | append: product_collection.id | append: '|'
  endfor

  for candidate_campaign in shop.metaobjects.sales_campaigns.values
    assign campaign_end_ts = 9999999999
    assign campaign_applies = false
    assign candidate_matched_offer = blank

    capture candidate_campaign_lifecycle
      render 'scs-campaign-lifecycle', campaign: candidate_campaign
    endcapture
    assign candidate_campaign_lifecycle = candidate_campaign_lifecycle | strip

    if candidate_campaign_lifecycle != 'active' and candidate_campaign_lifecycle != 'open_ended'
      continue
    endif

    if candidate_campaign.end_date != blank and candidate_campaign.end_date.value != blank
      assign campaign_end_ts = candidate_campaign.end_date.value | date: '%s' | plus: 0
    endif

    if candidate_campaign.sale_collection != blank and candidate_campaign.sale_collection.value != blank
      assign campaign_collection_token = '|' | append: candidate_campaign.sale_collection.value.id | append: '|'
      if product_collection_tokens contains campaign_collection_token
        assign campaign_applies = true
      endif
    endif

    if candidate_campaign.offers != blank and candidate_campaign.offers.value != blank
      if campaign_applies == false or campaign_end_ts < winning_campaign_end_ts
        for candidate_offer in candidate_campaign.offers.value
          if candidate_offer.products != blank and candidate_offer.products.value != blank
            for offered_product in candidate_offer.products.value
              if offered_product.id == product.id
                assign campaign_applies = true
                assign candidate_matched_offer = candidate_offer
                break
              endif
            endfor
          endif

          if candidate_matched_offer != blank
            break
          endif
        endfor
      endif
    endif

    if campaign_applies
      if campaign_end_ts < winning_campaign_end_ts
        assign winning_campaign = candidate_campaign
        assign winning_campaign_end_ts = campaign_end_ts
        assign matched_offer = candidate_matched_offer
      endif
    endif
  endfor

  if winning_campaign != blank
    capture campaign_url
      render 'scs-campaign-url', campaign: winning_campaign
    endcapture
    assign campaign_url = campaign_url | strip

    assign banner_body_field = blank
    assign banner_image = blank
    assign banner_image_url = campaign_url

    if matched_offer != blank
      if matched_offer.offer_description != blank
        assign banner_body_field = matched_offer.offer_description

        if matched_offer.offer_image != blank and matched_offer.offer_image.value != blank
          assign banner_image = matched_offer.offer_image.value
        endif

        if matched_offer.offer_image_link != blank and matched_offer.offer_image_link.value != blank
          assign banner_image_url = matched_offer.offer_image_link.value
        elsif winning_campaign.sale_image_url != blank and winning_campaign.sale_image_url.value != blank
          assign banner_image_url = winning_campaign.sale_image_url.value
        endif
      endif
    endif

    if banner_body_field == blank and winning_campaign.sale_list_text != blank
      assign banner_body_field = winning_campaign.sale_list_text
    endif

    if banner_body_field == blank and winning_campaign.banner_text != blank
      assign banner_body_field = winning_campaign.banner_text
    endif

    if banner_image == blank and winning_campaign.sale_image != blank and winning_campaign.sale_image.value != blank
      assign banner_image = winning_campaign.sale_image.value
    endif

    if banner_image_url == campaign_url and winning_campaign.sale_image_url != blank and winning_campaign.sale_image_url.value != blank
      assign banner_image_url = winning_campaign.sale_image_url.value
    endif

    assign show_banner_action = false
    if campaign_url != blank
      assign show_banner_action = true
    endif

    assign banner_image_link_url = banner_image_url
    if show_banner_action and banner_image_link_url == campaign_url
      assign banner_image_link_url = blank
    endif
  endif
%}
{% if winning_campaign != blank and banner_body_field != blank %}
  {% capture banner_content_markup %}
    <div class="scs-banner__body rte">
      {% render 'scs-richtext', field: banner_body_field %}
    </div>
    {% if show_banner_action %}
      <p class="scs-banner__cta">
        <a href="{{ campaign_url }}">{{ 'scs.storefront.index.view_sale' | t }}</a>
      </p>
    {% endif %}
  {% endcapture %}

  <div class="scs-banner{% if compact_spacing %} scs-banner--compact{% endif %}" data-scs-banner>
    {% if show_image and banner_image != blank %}
      <div class="scs-banner__media-layout">
        <div class="scs-banner__image-wrap">
          {% if banner_image_link_url != blank %}
            <a class="scs-banner__image-link" href="{{ banner_image_link_url }}">
              {% render 'image', image: banner_image, height: image_height %}
            </a>
          {% else %}
            <span class="scs-banner__image-placeholder">
              {% render 'image', image: banner_image, height: image_height %}
            </span>
          {% endif %}
        </div>
        <div class="scs-banner__content">
          {{ banner_content_markup }}
        </div>
      </div>
    {% else %}
      <div class="scs-banner__content">
        {{ banner_content_markup }}
      </div>
    {% endif %}
  </div>
{% endif %}
