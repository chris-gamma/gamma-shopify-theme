{%- if product.metafields.custom.battery_system and product.metafields.custom.battery_system.value != blank -%}
  {%- assign bat_sys = product.metafields.custom.battery_system.value -%}
  {%- assign width = 60 -%}
  <span style="display:inline-flex; align-items:center;">
    {%- if bat_sys.icon -%}
      {%- assign image_width = width -%}
      {%- assign image_width_2x = width | default: image_width | times: 2 -%}
      {%- assign image_width_3x = width | default: image_width | times: 3 -%}

      {%- capture image_srcset -%}
      {{ bat_sys.icon | image_url: width: image_width }} 1x, {{ bat_sys.icon | image_url: width: image_width_2x }} 2x, {{ bat_sys.icon | image_url: width: image_width_3x }} 3x
    {%- endcapture -%}

      {%- assign style_value = style | default: '' -%}

      {%- if unset_image_tag -%}
        {%- assign style_value = style_value | append: 'object-position: inherit;' -%}
      {%- endif -%}

      <span style="display: inline-block; width: {{ width }}px;">
        {{
          bat_sys.icon
          | image_url: width: image_width
          | image_tag: class: class, srcset: image_srcset, style: style_value
        }}
      </span>
    {%- endif -%}
    {%- if bat_sys.system_type -%}
      <span style="margin-left: 0.5rem;">
        {%- render 'text', fallback_text: bat_sys.system_type.value, class: 'h6' -%}
      </span>
    {%- endif -%}
  </span>
{%- endif -%}
