# =============================================================================
# .shopifyignore — Gamma Shopify Theme
#
# Controls which files Shopify CLI excludes from push/pull/dev operations.
# This file is a CLI control, not a Git control. It does not affect what
# Git tracks, and it is not used by the Shopify GitHub integration.
#
# Do NOT add Shopify theme-surface files here (assets/, blocks/, config/,
# layout/, locales/, sections/, snippets/, templates/). Those must remain
# deployable. In particular, config/settings_data.json must NOT be listed
# here — it is part of the live deployed theme.
# =============================================================================

# Repository infrastructure and tooling (not Shopify theme files)
.github/**
.venv/**
.git/**
.vscode/**

# Root documentation and project metadata
README.md
README-Horizon.md
CHANGES.md
LICENSE.md
LICENSE-Horizon.md
release-notes-horizon.md

# Root tooling config
pyrightconfig.json
shopify.theme.toml

# Local developer state (belt-and-suspenders; these are also git-ignored)
.env
.env.*
