{% doc %}
  @prompt
    Loop through the product's technical_specifications metafield if set, otherwise render nothing.
    Split each entry at the colon and strip whitespace, storing the two-item array in an array called "specs_items".
    Loop through specs_items and render each item as a row in a two-column table following the theme styling. Produce standard settings for a text block.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% if product.metafields.custom.technical_specifications != blank %}
  {% assign specs_raw = product.metafields.custom.technical_specifications | split: ',' %}
  {% assign specs_items = '' | split: '' %}
  
  {% for spec in specs_raw %}
    {% assign spec_parts = spec | split: ':' %}
    {% if spec_parts.size == 2 %}
      {% assign key = spec_parts[0] | strip %}
      {% assign value = spec_parts[1] | strip %}
      {% assign spec_pair = key | append: '|' | append: value %}
      {% assign specs_items = specs_items | push: spec_pair %}
    {% endif %}
  {% endfor %}

  {% if specs_items.size > 0 %}
    {% style %}
      .ai-tech-specs-{{ ai_gen_id }} {
        width: {{ block.settings.desktop_width_percent }}%;
        max-width: 100%;
        display: block;
      }

      .ai-tech-specs-table-{{ ai_gen_id }} {
        width: 100%;
        border-collapse: collapse;
        font-size: {{ block.settings.text_size }}px;
        color: {{ block.settings.text_color }};
      }

      .ai-tech-specs-table-{{ ai_gen_id }} tr {
        border-bottom: {{ block.settings.row_border_width }}px solid {{ block.settings.border_color }};
      }

      .ai-tech-specs-table-{{ ai_gen_id }} tr:last-child {
        border-bottom: none;
      }

      .ai-tech-specs-table-{{ ai_gen_id }} td {
        padding: {{ block.settings.cell_padding }}px;
        vertical-align: top;
      }

      .ai-tech-specs-table-{{ ai_gen_id }} td:first-child {
        font-weight: {{ block.settings.label_font_weight }};
        width: {{ block.settings.label_column_width }}%;
        color: {{ block.settings.label_color }};
      }

      .ai-tech-specs-table-{{ ai_gen_id }} td:last-child {
        width: {{ 100 | minus: block.settings.label_column_width }}%;
      }

      @media screen and (max-width: 749px) {
        .ai-tech-specs-table-{{ ai_gen_id }} {
          font-size: {{ block.settings.text_size | times: 0.9 }}px;
        }

        .ai-tech-specs-table-{{ ai_gen_id }} td {
          padding: {{ block.settings.cell_padding | times: 0.8 }}px;
        }
      }
    {% endstyle %}

    <div class="ai-tech-specs-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
      <table class="ai-tech-specs-table-{{ ai_gen_id }}">
        {% for spec_item in specs_items %}
          {% assign spec_data = spec_item | split: '|' %}
          {% if spec_data.size == 2 %}
            <tr>
              <td>{{ spec_data[0] }}</td>
              <td>{{ spec_data[1] }}</td>
            </tr>
          {% endif %}
        {% endfor %}
      </table>
    </div>
  {% endif %}
{% endif %}

{% schema %}
{
  "name": "Technical specifications",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "paragraph",
      "content": "Displays product.metafields.custom.technical_specifications as a two-column table. Format: 'Label: Value, Label: Value'"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "label_column_width",
      "label": "Label column width",
      "min": 20,
      "max": 60,
      "step": 5,
      "unit": "%",
      "default": 40
    },
    {
      "type": "range",
      "id": "cell_padding",
      "label": "Cell padding",
      "min": 4,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Text size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "select",
      "id": "label_font_weight",
      "label": "Label font weight",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semibold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "600"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "label_color",
      "label": "Label",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border",
      "default": "#e6e6e6"
    },
    {
      "type": "range",
      "id": "row_border_width",
      "label": "Row border width",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "default": 1
    }
  ],
  "presets": [
    {
      "name": "Technical specifications"
    }
  ]
}
{% endschema %}
