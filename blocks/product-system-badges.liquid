{% doc %}
  Renders a product system badge displaying battery system information.
  Pulls data from the product's custom battery_system metafield.

  Displays:
  - Battery system icon (locale-aware for FR/EN)
  - System type name
  - Linked to associated collection if available

  @example
  {% content_for 'block', type: 'product-system-badges' %}
{% enddoc %}

{%- liquid
  assign is_french_locale = false
  if request.locale.iso_code == 'fr' or request.locale.iso_code == 'fr-CA'
    assign is_french_locale = true
  endif

  if product.metafields.custom.battery_system and product.metafields.custom.battery_system.value != blank
    assign bat_sys = product.metafields.custom.battery_system.value
  endif
-%}
{%- if bat_sys -%}
  <div
    class="product-system-badges"
    {{ block.shopify_attributes }}
  >
    <span class="product-system-badges-battery-system" style="--icon-height: {{ block.settings.icon_height }}px;">
      {%- if bat_sys.collection -%}
        <a href="{{ bat_sys.collection.value.url }}" class="product-system-badges-collection-link">
      {%- endif -%}
      {%- if bat_sys.icon_fr and is_french_locale -%}
        {%- assign bat_sys_icon = bat_sys.icon_fr -%}
      {%- elsif bat_sys.icon_en -%}
        {%- assign bat_sys_icon = bat_sys.icon_en -%}
      {%- elsif bat_sys.icon_fr != blank -%}
        {%- assign bat_sys_icon = bat_sys.icon_fr -%}
      {%- endif -%}
      {%- if bat_sys_icon -%}
        <span class="product-system-badges-system-icon">
          {%- render 'image', image: bat_sys_icon, height: block.settings.icon_height -%}
        </span>
      {%- endif -%}
      {%- if bat_sys.system_type -%}
        <span class="h6 product-system-badges-system-type">{{ bat_sys.system_type }}</span>
      {%- endif -%}
      {%- if bat_sys.collection -%}
        </a>
      {%- endif -%}
    </span>
  </div>
{%- endif -%}

{% stylesheet %}
  .product-system-badges {
    display: inline-flex;
    align-items: center;
  }

  .product-system-badges-collection-link {
    display: block;
  }

  .product-system-badges-collection-link:hover,
  .product-system-badges-collection-link:focus {
    color: var(--color-primary-hover);
  }

  .product-system-badges-system-icon {
    display: inline-block;
    vertical-align: middle;
  }

  .product-system-badges-system-icon img {
    height: var(--icon-height);
    width: auto;
    max-width: none;
  }

  .product-system-badges-system-type {
    margin-left: var(--margin-xs);
    opacity: 0.9;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.product_system_badges",
  "settings": [
    {
      "type": "number",
      "id": "icon_height",
      "label": "t:settings.icon_height_px",
      "default": 30
    }
  ],
  "presets": [
    {
      "name": "t:names.product_system_badges",
      "settings": { "icon_height": 30 }
    }
  ]
}
{% endschema %}
