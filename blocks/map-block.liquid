{% comment %}
  Map view block
{% endcomment %}

{%- assign block_settings = block.settings -%}
{%- assign map_src_url = '//umap.openstreetmap.fr/'
  | append: request.locale.iso_code
  | append: '/map/'
  | append: block_settings.map_src
  | append: '?scaleControl=false&amp;amp;miniMap=false&amp;amp;scrollWheelZoom=true&amp;amp;zoomControl=true&amp;amp;editMode=disabled&amp;amp;moreControl=false&amp;amp;searchControl=false&amp;amp;tilelayersControl=false&amp;amp;embedControl=false&amp;amp;datalayersControl=false&amp;amp;onLoadPanel=none&amp;amp;captionBar=false&amp;amp;captionMenus=false&amp;amp;homeControl=false&amp;amp;captionControl=false'
-%}
{%- liquid
  if block_settings.placeholder_image != blank
    assign placeholder_image = block_settings.placeholder_image | image_url: width: block_settings.placeholder_image.width
  else
    if block_settings.mobile_placeholder_image != blank
      assign placeholder_image = block_settings.mobile_placeholder_image | image_url: width: block_settings.map_width
    endif
  endif
  if block_settings.mobile_placeholder_image != blank
    assign mobile_placeholder_image = block_settings.mobile_placeholder_image | image_url: width: block_settings.mobile_placeholder_image.width
  else
    if block_settings.placeholder_image != blank
      assign mobile_placeholder_image = block_settings.placeholder_image | image_url: width: block_settings.mobile_map_width
    endif
  endif
-%}
<div
  class="map-frame"
  style="--map-width: {{ block_settings.map_width }}px; --map-height: {{ block_settings.map_height }}px; --mobile-map-width: {{ block_settings.mobile_map_width }}px; --mobile-map-height: {{ block_settings.mobile_map_height }}px;"
  data-map-src="{{ map_src_url | escape }}"
  data-map-initialized="false"
>
  {%- if placeholder_image != blank -%}
    <button
      type="button"
      class="map-placeholder-button"
      aria-label="{{ 'content.view_map' | t | default: 'Voir carte' }}"
      style="--placeholder-image: url({{ placeholder_image }}); --mobile-placeholder-image: url({{ mobile_placeholder_image }});"
    ></button>
  {%- else -%}
    <button
      type="button"
      class="button-secondary map-placeholder-button map-placeholder-fallback"
      aria-label="{{ 'content.view_map' | t | default: 'Voir carte' }}"
    >
      {{ 'content.view_map' | t | default: 'Voir carte' }}
    </button>
  {%- endif -%}

  <div class="loading-indicator" aria-hidden="true"></div>

  <button
    type="button"
    class="map-disable-button"
    aria-label="{{ 'content.disable_map' | t | default: 'Désactiver les cartes' }}"
  >
    {{- 'icon-disable-map.svg' | inline_asset_content -}}
  </button>

  <noscript>
    <iframe
      class="map-frame"
      allowfullscreen
      loading="lazy"
      src="{{ map_src_url | escape }}"
    ></iframe>
  </noscript>
</div>
{%- if block_settings.show_directions -%}
  <div class="map-directions">
    {%- if block_settings.google_maps_directions -%}
      <a href="{{ block_settings.google_maps_directions }}" target="_blank" class="link map-directions-link">
        {{- 'icon-directions.svg' | inline_asset_content -}}
        {{ 'content.google_maps_directions' | t }}
      </a>
    {%- endif -%}
    {%- if block_settings.apple_maps_directions -%}
      <a href="{{ block_settings.apple_maps_directions }}" target="_blank" class="link map-directions-link">
        {{- 'icon-directions.svg' | inline_asset_content -}}
        {{ 'content.apple_maps_directions' | t }}
      </a>
    {%- endif -%}
  </div>
{%- endif -%}

{% stylesheet %}
  .map-directions {
    display: flex;
    align-items: center;
    gap: var(--padding-xs);
    padding: 0 var(--padding-3xs);
  }

  .map-frame {
    width: var(--map-width);
    height: var(--map-height);
    border: 0;
    position: relative;
    overflow: hidden;
  }

  .map-frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    opacity: 0;
  }

  .map-frame.map-loaded iframe {
    opacity: 1;
  }

  .map-placeholder-button {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    padding: 0;
    background-image: var(--placeholder-image);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    z-index: 1;
  }

  .map-frame.map-loaded .map-placeholder-button {
    opacity: 0;
    pointer-events: none;
    visibility: hidden;
  }

  .map-frame.map-loading .loading-indicator {
    display: flex;
  }

  .map-disable-button {
    position: absolute;
    top: 5px;
    right: 5px;
    width: 30px;
    height: 30px;
    margin: 0;
    padding: 0;
    background-color: #ffffff;
    border: 1px solid rgba(128, 128, 128, 0.5);
    display: none;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 3;
  }

  .map-frame.map-loaded .map-disable-button {
    display: flex;
  }

  .map-disable-button svg {
    width: 25px;
    height: 25px;
    display: block;
  }

  .map-directions-link {
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
    gap: var(--padding-3xs);
    font-size: var(--font-size--body-sm) !important;
  }

  .map-directions a svg {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
  }

  @media screen and (max-width: 749px) {
    .map-frame {
      width: var(--mobile-map-width);
      height: var(--mobile-map-height);
      border: 0;
    }

    .map-placeholder-button {
      background-image: var(--mobile-placeholder-image);
    }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    var COOKIE_NAME = 'gamma_map_iframes_enabled';
    var COOKIE_VALUE = '1';

    function hasMapCookie() {
      var cookie = document.cookie;
      if (!cookie) return false;
      var parts = cookie.split(';');
      for (var i = 0; i < parts.length; i++) {
        var part = parts[i].trim();
        if (part.indexOf(COOKIE_NAME + '=') === 0) {
          return part.substring(COOKIE_NAME.length + 1) === COOKIE_VALUE;
        }
      }
      return false;
    }

    function setMapCookie() {
      document.cookie = COOKIE_NAME + '=' + COOKIE_VALUE + '; path=/';
    }

    function clearMapCookie() {
      document.cookie = COOKIE_NAME + '=; path=/; expires=Thu, 01 Jan 1970 00:00:00 GMT';
    }

    var containers = document.querySelectorAll('.map-frame[data-map-initialized="false"]');

    function initContainer(container) {
      if (container.dataset.mapInitialized === 'true') return;
      var src = container.dataset.mapSrc;
      if (!src) return;
      container.dataset.mapInitialized = 'true';
      container.classList.add('map-loading');
      var iframe = document.createElement('iframe');
      iframe.className = 'map-frame-iframe';
      iframe.setAttribute('allowfullscreen', '');
      iframe.setAttribute('loading', 'lazy');
      iframe.src = src;
      container.appendChild(iframe);
      iframe.addEventListener('load', function () {
        container.classList.remove('map-loading');
        container.classList.add('map-loaded');
      });
    }

    function disableAllMaps() {
      clearMapCookie();
      for (var i = 0; i < containers.length; i++) {
        var container = containers[i];
        container.classList.remove('map-loaded');
        container.classList.remove('map-loading');
        container.dataset.mapInitialized = 'false';
        var iframe = container.querySelector('iframe');
        if (iframe) {
          iframe.src = 'about:blank';
          container.removeChild(iframe);
        }
      }
    }

    if (hasMapCookie()) {
      for (var i = 0; i < containers.length; i++) {
        initContainer(containers[i]);
      }
    }

    for (var j = 0; j < containers.length; j++) {
      var container = containers[j];
      var placeholderButton = container.querySelector('.map-placeholder-button');
      if (!placeholderButton) continue;
      placeholderButton.addEventListener('click', function () {
        setMapCookie();
        for (var k = 0; k < containers.length; k++) {
          initContainer(containers[k]);
        }
      });
    }

    var disableButtons = document.querySelectorAll('.map-disable-button');
    for (var l = 0; l < disableButtons.length; l++) {
      disableButtons[l].addEventListener('click', function () {
        disableAllMaps();
      });
    }
  })();
{% endjavascript %}

{% schema %}
{
  "name": "Map block",
  "settings": [
    {
      "type": "number",
      "id": "map_width",
      "label": "Map width (px)",
      "default": 400
    },
    {
      "type": "number",
      "id": "map_height",
      "label": "Map height (px)",
      "default": 300
    },
    {
      "type": "number",
      "id": "mobile_map_width",
      "label": "Mobile map width (px)",
      "default": 320
    },
    {
      "type": "number",
      "id": "mobile_map_height",
      "label": "Mobile map height (px)",
      "default": 240
    },
    {
      "type": "image_picker",
      "id": "placeholder_image",
      "label": "Placeholder image"
    },
    {
      "type": "image_picker",
      "id": "mobile_placeholder_image",
      "label": "Mobile placeholder image"
    },
    {
      "type": "text",
      "id": "map_src",
      "label": "Map embed code",
      "default": "carte-location-gamma-map_1369176"
    },
    {
      "type": "checkbox",
      "id": "show_directions",
      "label": "Show directions links",
      "default": true
    },
    {
      "type": "text",
      "id": "google_maps_directions",
      "label": "Google Maps directions URL",
      "default": "https://www.google.com/maps/dir//5840%20Rue%20Saint-Jacques,%20Montr%C3%A9al,%20QC%20H4A%202E9"
    },
    {
      "type": "text",
      "id": "apple_maps_directions",
      "label": "Apple Maps directions URL",
      "default": "http://maps.apple.com/?daddr=5840%20Rue%20Saint-Jacques,%20Montr%C3%A9al,%20QC%20H4A%202E9"
    }
  ],
  "blocks": [],
  "presets": [
    {
      "name": "Map block"
    }
  ]
}
{% endschema %}