{% liquid
  assign visible_campaign_handles_csv = blank

  for campaign in shop.metaobjects.sales_campaigns.values
    capture campaign_lifecycle
      render 'scs-campaign-lifecycle', campaign: campaign
    endcapture
    assign campaign_lifecycle = campaign_lifecycle | strip

    assign render_campaign = false
    if campaign_lifecycle == 'active' or campaign_lifecycle == 'open_ended'
      assign render_campaign = true
    elsif campaign_lifecycle == 'ended' and section.settings.show_ended_campaigns
      assign render_campaign = true
    endif

    if render_campaign
      if visible_campaign_handles_csv != blank
        assign visible_campaign_handles_csv = visible_campaign_handles_csv | append: ','
      endif
      assign visible_campaign_handles_csv = visible_campaign_handles_csv | append: campaign.system.handle
    endif
  endfor

  if visible_campaign_handles_csv != blank
    assign visible_campaign_handles = visible_campaign_handles_csv | split: ','
  endif
%}
<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section
  class="section section--page-width color-{{ section.settings.color_scheme }} scs-index"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  <div class="scs-index__content">
    {% if section.settings.heading != blank or section.settings.body != blank %}
      <header class="scs-index__header">
        {% if section.settings.heading != blank %}
          <h1>{{ section.settings.heading }}</h1>
        {% endif %}
        {% if section.settings.body != blank %}
          <div class="rte">{{ section.settings.body }}</div>
        {% endif %}
      </header>
    {% endif %}

    {% if visible_campaign_handles_csv != blank %}
      {% paginate visible_campaign_handles by section.settings.campaigns_per_page %}
        <div class="scs-index__grid" data-scs-index-grid>
          {% for campaign_handle in visible_campaign_handles %}
            {% if campaign_handle != blank %}
              {% assign campaign = shop.metaobjects.sales_campaigns[campaign_handle] %}
              {% if campaign != blank %}
                {% render 'scs-campaign-card', campaign: campaign %}
              {% endif %}
            {% endif %}
          {% endfor %}
        </div>

        {% if paginate.pages > 1 %}
          <nav class="scs-index__pagination" aria-label="{{ 'content.pagination.nav_label' | t }}">
            {{ paginate | default_pagination }}
          </nav>
        {% endif %}
      {% endpaginate %}
    {% else %}
      <div class="scs-index__grid" data-scs-index-grid></div>
    {% endif %}
  </div>
</section>
{% stylesheet %}
  .scs-index__content {
    width: 100%;
  }

  .scs-index__header {
    margin-bottom: 2rem;
  }

  .scs-index__header h1 {
    margin: 0 0 0.5rem;
  }

  .scs-index__header .rte {
    margin: 0;
  }

  .scs-index__grid {
    display: grid;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .scs-index__pagination {
    display: flex;
    justify-content: center;
  }

  .scs-card {
    border: 1px solid rgba(0, 0, 0, 0.12);
    border-radius: 1rem;
    overflow: hidden;
    background: rgba(0, 0, 0, 0.02);
  }

  .scs-card__media {
    display: block;
    width: 100%;
  }

  .scs-card__media a {
    display: block;
  }

  .scs-card__content {
    padding: 1rem;
  }

  .scs-card__title {
    margin: 0 0 0.5rem;
  }

  .scs-card__title a {
    color: inherit;
    text-decoration: none;
  }

  .scs-card__title a:hover {
    text-decoration: underline;
  }

  .scs-card__body :is(p, ul, ol) {
    margin: 0 0 0.5rem;
  }

  .scs-card__body :is(p, ul, ol):last-child {
    margin-bottom: 0;
  }

  .scs-card__cta {
    margin: 0.5rem 0 0;
  }

  .scs-card__cta a {
    font-weight: 500;
  }

  @media screen and (min-width: 750px) {
    .scs-index__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
{% endstylesheet %}
{% schema %}
{
  "name": "t:scs.index_section.name",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:scs.index_section.settings.heading",
      "default": "Promotions"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "t:scs.index_section.settings.body"
    },
    {
      "type": "range",
      "id": "campaigns_per_page",
      "label": "t:scs.index_section.settings.campaigns_per_page",
      "min": 4,
      "max": 24,
      "step": 1,
      "default": 12
    },
    {
      "type": "checkbox",
      "id": "show_ended_campaigns",
      "label": "t:scs.index_section.settings.show_ended_campaigns",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:scs.index_section.settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:scs.index_section.settings.padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:scs.index_section.settings.padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "t:scs.index_section.name"
    }
  ]
}
{% endschema %}
