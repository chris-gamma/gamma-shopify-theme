<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section
  class="section section--page-width color-{{ section.settings.color_scheme }} scs-index"
  data-scs-surface="index"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  <div class="scs-index__content">
    {% if section.settings.heading != blank or section.settings.body != blank %}
      <header class="scs-index__header">
        {% if section.settings.heading != blank %}
          <h1>{{ section.settings.heading }}</h1>
        {% endif %}
        {% if section.settings.body != blank %}
          <div class="rte">{{ section.settings.body }}</div>
        {% endif %}
      </header>
    {% endif %}

    {% liquid
      assign campaign_sort_records = ''

      for campaign in shop.metaobjects.sales_campaigns.values
        capture campaign_lifecycle
          render 'scs-campaign-lifecycle', campaign: campaign
        endcapture
        assign campaign_lifecycle = campaign_lifecycle | strip

        assign render_campaign = false
        assign campaign_bucket_rank = blank

        if campaign_lifecycle == 'active' or campaign_lifecycle == 'open_ended'
          assign render_campaign = true
          assign campaign_bucket_rank = '0'
        elsif campaign_lifecycle == 'ended' and section.settings.show_ended_campaigns
          capture campaign_is_in_ended_window
            render 'scs-campaign-ended-window', campaign: campaign
          endcapture
          assign campaign_is_in_ended_window = campaign_is_in_ended_window | strip

          if campaign_is_in_ended_window == 'true'
            assign render_campaign = true
            assign campaign_bucket_rank = '1'
          endif
        endif

        if render_campaign
          assign campaign_priority = 10
          if campaign.sale_list_priority != blank and campaign.sale_list_priority.value != blank
            assign campaign_priority = campaign.sale_list_priority.value | plus: 0
          endif
          assign campaign_priority_sort = campaign_priority | plus: 1000000

          assign campaign_end_ts = 9999999999
          if campaign.end_date != blank and campaign.end_date.value != blank
            assign campaign_end_ts = campaign.end_date.value | date: '%s' | plus: 0
          endif

          capture campaign_sort_record
            echo campaign_bucket_rank
            echo '~'
            echo campaign_priority_sort
            echo '~'
            echo campaign_end_ts
            echo '~'
            echo campaign.system.handle
          endcapture
          assign campaign_sort_record = campaign_sort_record | strip

          if campaign_sort_records == ''
            assign campaign_sort_records = campaign_sort_record
          else
            assign campaign_sort_records = campaign_sort_records | append: '||' | append: campaign_sort_record
          endif
        endif
      endfor

      assign sorted_campaign_records = '' | split: ','
      if campaign_sort_records != ''
        assign sorted_campaign_records = campaign_sort_records | split: '||' | sort_natural
      endif
    %}

    {% if sorted_campaign_records.size > 0 %}
      <ul class="scs-index__grid" data-scs-index-grid role="list">
        {% for campaign_record in sorted_campaign_records %}
          {% assign campaign_record_parts = campaign_record | split: '~' %}
          {% assign campaign_handle = campaign_record_parts[3] %}
          {% assign sorted_campaign = shop.metaobjects.sales_campaigns[campaign_handle] %}
          {% if sorted_campaign != blank %}
            <li class="scs-index__item">
              {% render 'scs-campaign-card', campaign: sorted_campaign %}
            </li>
          {% endif %}
        {% endfor %}
      </ul>
    {% else %}
      <div class="scs-empty" data-scs-index-empty>
        <p>{{ 'scs.storefront.empty.no_campaigns' | t }}</p>
      </div>
    {% endif %}
  </div>
</section>
{% stylesheet %}
  .scs-index__content {
    width: 100%;
  }

  .scs-index__header {
    margin-bottom: 2rem;
  }

  .scs-index__header h1 {
    margin: 0 0 0.5rem;
  }

  .scs-index__header .rte {
    margin: 0;
  }

  .scs-index__grid {
    display: grid;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    gap: 1rem;
    margin-bottom: 2rem;
    list-style: none;
    margin-inline: 0;
    padding: 0;
  }

  .scs-index__item {
    list-style: none;
  }

  .scs-card {
    border: 1px solid rgba(0, 0, 0, 0.12);
    border-radius: 1rem;
    overflow: hidden;
    background: rgba(0, 0, 0, 0.02);
  }

  .scs-card__media {
    display: block;
    width: 100%;
  }

  .scs-card__content {
    padding: 1rem;
  }

  .scs-card__title {
    margin: 0 0 0.5rem;
  }

  .scs-card__title a {
    color: inherit;
    text-decoration: none;
  }

  .scs-card__title a:hover {
    text-decoration: underline;
  }

  .scs-card__body :is(p, ul, ol) {
    margin: 0 0 0.5rem;
  }

  .scs-card__body :is(p, ul, ol):last-child {
    margin-bottom: 0;
  }

  .scs-card__cta {
    margin: 0.5rem 0 0;
    font-weight: 500;
  }

  .scs-empty {
    padding: 2rem 0;
    text-align: center;
  }

  @media screen and (min-width: 750px) {
    .scs-index__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
{% endstylesheet %}
{% schema %}
{
  "name": "t:scs.index_section.name",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:scs.index_section.settings.heading",
      "default": "Promotions"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "t:scs.index_section.settings.body"
    },
    {
      "type": "checkbox",
      "id": "show_ended_campaigns",
      "label": "t:scs.index_section.settings.show_ended_campaigns",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:scs.index_section.settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:scs.index_section.settings.padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:scs.index_section.settings.padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "t:scs.index_section.name"
    }
  ]
}
{% endschema %}
