# =============================================================================
# .gitignore — Gamma Shopify Theme
#
# Purpose-built for a buildless Shopify theme: no Node build step, no bundler,
# no generated output directory. Theme source ships directly via Shopify CLI.
# =============================================================================


# =============================================================================
# A. OS / Editor junk
# =============================================================================

# Linux
*~
.fuse_hidden*
.Trash-*
.nfs*
.directory

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/
*.stackdump
*.lnk

# Visual Studio Code
# Ignore local workspace overrides; shared settings files are tracked if added.
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets
.history/
.history
.ionide

# JetBrains IDEs
.idea/


# =============================================================================
# B. Python tooling artifacts
#
# The repo contains Python scripts for theme validation and CI hooks.
# .venv/ and cache directories are local-only and must not be committed.
#
# IMPORTANT: pyrightconfig.json files in this repo are tracked project
# artifacts — one at the root, one per Python script subproject. Do NOT
# add pyrightconfig.json to this section.
# =============================================================================

__pycache__/
*.py[cod]
*$py.class

# Virtualenvs
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Type-checker and linter caches
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/

# Test / coverage
.pytest_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
*.py,cover
.hypothesis/
nosetests.xml

# Build / packaging debris
*.egg-info/
*.egg
.eggs/
MANIFEST
dist/
build/
wheels/
sdist/
develop-eggs/
parts/
var/
lib-cov

# Misc Python tools
.pybuilder/
.ipynb_checkpoints
celerybeat-schedule
celerybeat.pid
cython_debug/


# =============================================================================
# C. Node / JS tooling
#
# This repo has no Node packages and no bundler. These patterns are a light
# defensive layer in case tools are installed experimentally.
# =============================================================================

node_modules/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.npm
.eslintcache
.stylelintcache
*.tsbuildinfo


# =============================================================================
# D. Shopify CLI and local theme state
#
# .shopify/ is the Shopify CLI runtime state directory. It also has its own
# nested .gitignore that ignores everything inside it. This root-level rule
# provides belt-and-suspenders safety and makes the intent explicit.
# =============================================================================

.shopify/


# =============================================================================
# E. Local developer config and secrets
# =============================================================================

.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local


# =============================================================================
# F. Locale allowlist
#
# Only the four locale files listed in .github/locale-allowlist.txt may be
# tracked. All other locale files that arrive via upstream Horizon syncs must
# not be committed. The validate_locale_allowlist.py script and the CI job
# enforce this policy. Keep this section in sync with:
#   .github/locale-allowlist.txt
# =============================================================================

locales/*
!locales/en.default.json
!locales/en.default.schema.json
!locales/fr.json
!locales/fr.schema.json
